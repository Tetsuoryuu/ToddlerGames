# Required: Your Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Overrides (Defaults to October 2026 Gemini 3.x & Nano Banana 2.1 lineup)
GEMINI_BRAIN_MODEL=gemini-3.8-flash
GEMINI_FAST_BRAIN_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_FAST_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Server Port
PORT=3001
